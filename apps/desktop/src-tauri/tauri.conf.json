{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hashgram",
  "version": "0.1.1",
  "identifier": "io.hashgram.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hashgram",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#000000",
        "theme": "Dark",
        "visible": true,
        "focus": true,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msEdgeCrashReporting --disable-breakpad --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-first-run --no-default-browser-check --renderer-process-limit=1 --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/Hashgram/data/media-cache/**", "$APPLOCALDATA/**", "$TEMP/**"]
      }
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRTk0RDZFODdCQTRCRTUKUldUbFM3cUhiazNwTW55NExKb0U5OWh3N0NLTU9panBZaU41TGVEa3pjeFBaNEtTUnlJcTZDcDIK",
      "endpoints": ["https://github.com/deepdrogo/hashgram_windows/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["hashgram"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "publisher": "Hashgram",
    "copyright": "Apache-2.0",
    "category": "SocialNetworking",
    "shortDescription": "Hashgram for Windows",
    "longDescription": "Wallet, messenger, social network, calls, identity and node for the Hashgram network. Talks directly to peer-to-peer nodes, never to one server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["binaries/hashgram-node", "binaries/hashgram-node-service"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "compression": "lzma",
        "startMenuFolder": "Hashgram"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
