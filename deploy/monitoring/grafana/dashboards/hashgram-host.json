{
  "uid": "hashgram-host",
  "title": "Hashgram / Host and Database",
  "description": "CPU, memory, disk, network and PostgreSQL health for a Hashgram node. Host metrics come from prometheus-node-exporter and database metrics from prometheus-postgres-exporter; both are localhost-only. A chain node is a stateful database server with a consensus protocol attached, and it fails in the ways databases fail: disk, memory, and I/O.",
  "tags": ["hashgram", "host", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Resources",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "CPU used",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "cpu %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "gauge",
      "title": "Memory used",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "memory %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "bargauge",
      "title": "Disk used by mount",
      "description": "The chain database lives under /var/lib/hashgram. A node that fills its disk stops committing blocks and can corrupt its database, so this is the host metric that matters most.",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 6, "w": 14, "x": 10, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|squashfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|squashfs|overlay\"})",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Disk free, with a week's projection",
      "description": "The dashed series extrapolates the last six hours forward. If it crosses zero, plan pruning or a larger volume now rather than during an incident.",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|squashfs|overlay\"}",
          "legendFormat": "free {{mountpoint}}"
        },
        {
          "refId": "B",
          "expr": "predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|squashfs|overlay\"}[6h], 7 * 24 * 3600)",
          "legendFormat": "projected in 7d {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "projected.*" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Chain nodes are I/O bound during state commits and during catch-up. Sustained high utilisation shows up in block processing time before it shows up anywhere else.",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total[5m])",
          "legendFormat": "read {{device}}"
        },
        {
          "refId": "B",
          "expr": "-rate(node_disk_written_bytes_total[5m])",
          "legendFormat": "write {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "Network throughput",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m])",
          "legendFormat": "in {{device}}"
        },
        {
          "refId": "B",
          "expr": "-rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m])",
          "legendFormat": "out {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "Chain process resources",
      "description": "Resident memory, goroutines and open file descriptors for hashgramd itself, as opposed to the host total. Goroutines climbing without bound is the usual signature of a leak in a P2P reactor.",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"hashgramd\"}",
          "legendFormat": "resident memory"
        },
        {
          "refId": "B",
          "expr": "go_goroutines{job=\"hashgramd\"}",
          "legendFormat": "goroutines"
        },
        {
          "refId": "C",
          "expr": "process_open_fds{job=\"hashgramd\"}",
          "legendFormat": "open fds"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "resident memory" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "Clock offset",
      "description": "CometBFT validators depend on roughly synchronised clocks for proposal timing. Drift beyond a fraction of a second is worth fixing before it becomes missed proposals.",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_timex_offset_seconds",
          "legendFormat": "offset"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "row",
      "title": "PostgreSQL (phase 2 indexer)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "PostgreSQL",
      "description": "The chain does not depend on Postgres. If the database is down, consensus continues and the indexer can be rebuilt from chain state afterwards.",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "exporter absent",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" }
    },
    {
      "type": "timeseries",
      "title": "Connections",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 6, "w": 10, "x": 4, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "pg_settings_max_connections",
          "legendFormat": "limit"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "limit" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Database size and transaction rate",
      "datasource": { "type": "prometheus", "uid": "hashgram-prometheus" },
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes",
          "legendFormat": "size {{datname}}"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_commit[5m])",
          "legendFormat": "commits/s {{datname}}"
        },
        {
          "refId": "C",
          "expr": "rate(pg_stat_database_xact_rollback[5m])",
          "legendFormat": "rollbacks/s {{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "size.*" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
    }
  ]
}
